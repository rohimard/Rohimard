{
  "expo": {
    "name": "PhotoBrush",
    "slug": "photobrush",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0B0B0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.rohimard.photobrush",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "PhotoBrush necesita acceso a tus fotos para editarlas.",
        "NSPhotoLibraryAddUsageDescription": "PhotoBrush guarda las fotos editadas en tu galería."
      }
    },
    "android": {
      "package": "com.rohimard.photobrush",
      "permissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "PhotoBrush necesita acceso a tus fotos para editarlas."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PhotoBrush necesita acceso a tus fotos para editarlas.",
          "savePhotosPermission": "PhotoBrush guarda las fotos editadas en tu galería."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4a6ec4ad-c001-496d-b86a-2fc767c6c97c"
      }
    },
    "owner": "rohimards-team"
  }
}
