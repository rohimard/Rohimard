# MOMENTIA — variables de entorno
# Copia este archivo como `.env.local` y completa los valores.
# El sitio funciona SIN Supabase configurado (landing, configurador visual y
# la experiencia /m/demo), pero para guardar pedidos, experiencias reales y
# usar el panel /admin necesitas completar las variables de Supabase.

# Proyecto Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# ¡Nunca la expongas al cliente! Solo se usa en Server Actions (lib/supabase/admin.ts).
SUPABASE_SERVICE_ROLE_KEY=

# URL pública del sitio (usada en metadata, Open Graph y sitemap)
NEXT_PUBLIC_SITE_URL=https://momentia.pe

# WhatsApp de ventas — código de país + número, sin "+" ni espacios (ej. Perú: 51987654321)
NEXT_PUBLIC_WHATSAPP_NUMBER=51999999999

# Redes sociales (opcional — si no se configuran, se usan enlaces de referencia)
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/momentia.pe
NEXT_PUBLIC_TIKTOK_URL=https://tiktok.com/@momentia.pe
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/momentia.pe
NEXT_PUBLIC_CONTACT_EMAIL=hola@momentia.pe
