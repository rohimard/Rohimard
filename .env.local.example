# CotizaPro — variables de entorno
# Copia este archivo como `.env.local` y rellena tus credenciales.
#
# La app funciona SIN ninguna de estas variables (modo demo).

# --- Supabase: activa registro/login y datos reales -------------------------
# Project Settings → API en https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Hugging Face: activa el asistente "Cotiza con IA" ----------------------
# Crea un token de tipo "Read" (o Fine-grained con permiso de Inference)
# en https://huggingface.co/settings/tokens
# Nunca se expone al navegador: solo lo usan las Server Actions.
HF_TOKEN=

# Opcional. Lista de modelos separados por coma; se prueban en orden.
# Por defecto: openai/gpt-oss-120b,meta-llama/Llama-3.3-70B-Instruct,Qwen/Qwen2.5-72B-Instruct
HF_MODEL=

# --- Monetización -----------------------------------------------------------
# Opcional. Enlace de pago del plan Pro (Stripe Payment Link, Lemon Squeezy,
# Gumroad…). Si está vacío, el botón de /precios abre un correo.
NEXT_PUBLIC_CHECKOUT_URL=
