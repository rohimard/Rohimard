canal-cerebro-traidor/producciones/**/*.mp4

# modelos de la voz del narrador — binarios pesados, se descargan de releases de GitHub
# (ver las URLs en la cabecera de canal-youtube/voz-narrador.py).
# La referencia de Kevin sí se versiona: sin ella la voz no es reproducible.
canal-youtube/kokoro-models/
canal-youtube/freevc-models/*
!canal-youtube/freevc-models/kevin-referencia.mp3

# clave de la API de voz (nunca al repo)
canal-youtube/.google-tts-key
