# Copia este fichero a .env y rellena lo que necesites.
# Sin STRIPE_SECRET_KEY la app arranca en MODO DEMO y el pago se simula.

# --- Stripe (modo test: claves que empiezan por sk_test_ / pk_test_) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# --- Producto ---
MARCA=AuditaWeb
PRECIO_CENTIMOS=2900
MONEDA=eur

# --- Servidor ---
# Obligatorio en produccion: Stripe necesita URLs absolutas de vuelta.
APP_BASE_URL=
# Genera una con: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=
PORT=5000
DEBUG=0
