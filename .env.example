# Copia este archivo a ".env" y rellena tu clave.
#
# Consigue una API key gratuita de Pexels en:
#   https://www.pexels.com/api/
#
# Si dejas esto vacío, la app funciona igual en "modo demo"
# usando imágenes placeholder generadas localmente.
PEXELS_API_KEY=

# Puerto del servidor (opcional).
PORT=3000
