# ── Claude (obligatorio para generar guion y prompts) ──────────────────────
# Consíguela en https://console.anthropic.com/  (Settings → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Modelo a usar (opcional). Por defecto: claude-opus-5
CLAUDE_MODEL=claude-opus-5

# Idioma de las salidas (guion, prompts, SEO). Por defecto: es
IDIOMA=es

# ── YouTube Data API v3 (recomendado para datos reales de canales) ─────────
# Consíguela en https://console.cloud.google.com/  → habilita "YouTube Data API v3"
# Sin esta clave, la investigación usa la búsqueda web de Claude como respaldo.
YOUTUBE_API_KEY=

# ── Pexels (para descargar imágenes de stock gratis) ───────────────────────
# Consíguela gratis en https://www.pexels.com/api/
# Sin esta clave, solo se generan los prompts de imágenes (no se descargan fotos).
PEXELS_API_KEY=
