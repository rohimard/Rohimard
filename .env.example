# Copia este archivo a ".env" y rellena tu clave.
#
# Consigue una API key gratuita de Pexels en:
#   https://www.pexels.com/api/
#
# Si dejas esto vacío, la app funciona igual en "modo demo"
# usando imágenes placeholder generadas localmente.
PEXELS_API_KEY=

# Puerto del servidor (opcional).
PORT=3000

# ---------------------------------------------------------------------------
# Generación con IA (OPCIONAL — apagada por defecto)
# ---------------------------------------------------------------------------
# Deja AI_PROVIDER vacío y la IA no se usará (todo será stock/demo).
# Cuando tengas una cuenta, pon el proveedor y su clave, y reinicia la app.
#
#   AI_PROVIDER=replicate   -> Flux Schnell, muy barato (~$0.003/imagen)
#                              clave: https://replicate.com/account/api-tokens
#   AI_PROVIDER=openai      -> DALL·E 3 (~$0.04-0.08/imagen)
#                              clave: https://platform.openai.com/api-keys
AI_PROVIDER=
REPLICATE_API_TOKEN=
OPENAI_API_KEY=
